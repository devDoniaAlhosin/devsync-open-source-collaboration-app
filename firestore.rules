rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Projects are created and edited by their owner. Any signed-in user can
    // read the catalogue. View/request counters are incremented by other
    // users' transactions, so authenticated updates stay allowed for now;
    // tighten this to owner + counter-only diffs once counters move to a
    // Cloud Function.
    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // One document per viewer per day: `{projectId}_{uid}_{yyyy-MM-dd}`.
    match /views/{viewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.viewerId == request.auth.uid;
      allow update, delete: if false;
    }

    // Collaboration requests are written by the requester and answered by the
    // project owner through the requests feature.
    match /requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.requesterId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.ownerId == request.auth.uid
          || resource.data.requesterId == request.auth.uid);
      allow delete: if false;
    }
  }
}
