rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Projects are created and edited by their owner. Any signed-in user can
    // read the catalogue.
    //
    // Counters (`requestsCount`, `viewsCount`) are the only fields a non-owner
    // may touch, and only through a single +1 diff. Project content, ownership
    // and deletion stay owner-only. Move these counters to Cloud Functions
    // when the team enables them, then this exception can be removed.
    match /projects/{projectId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return isSignedIn() && resource.data.ownerId == request.auth.uid;
      }

      // The request feature creates `requests/{uid}_{projectId}` in the same
      // transaction, so a request-counter bump can be tied to that write.
      function requestCreatedByViewer() {
        let requestPath = /databases/$(database)/documents/requests/$(request.auth.uid + '_' + projectId);
        return existsAfter(requestPath)
          && getAfter(requestPath).data.projectId == projectId
          && getAfter(requestPath).data.senderId == request.auth.uid
          && getAfter(requestPath).data.ownerId == resource.data.ownerId;
      }

      function onlyIncrementsRequestsCount() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requestsCount'])
          && request.resource.data.requestsCount is int
          && request.resource.data.requestsCount == resource.data.get('requestsCount', 0) + 1;
      }

      function onlyIncrementsViewsCount() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount'])
          && request.resource.data.viewsCount is int
          && request.resource.data.viewsCount == resource.data.get('viewsCount', 0) + 1;
      }

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.ownerId is string
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId.size() > 0
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() > 0;

      allow update: if (
        // Owner content edits must keep the owner fields intact.
        isOwner()
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.ownerName is string
          && request.resource.data.ownerName.size() > 0
      ) || (
        // Counter-only diffs written by other users' transactions.
        isSignedIn()
          && onlyIncrementsRequestsCount()
          && requestCreatedByViewer()
      ) || (
        isSignedIn()
          && onlyIncrementsViewsCount()
      );

      allow delete: if isOwner();
    }

    // One document per viewer per day: `{projectId}_{uid}_{yyyy-MM-dd}`.
    match /views/{viewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.viewerId == request.auth.uid;
      allow update, delete: if false;
    }

    match /requests/{requestId} {
      function projectOwnedBy(projectId, ownerId) {
        let projectPath = /databases/$(database)/documents/projects/$(projectId);
        return exists(projectPath) && get(projectPath).data.ownerId == ownerId;
      }

      function validRequestData(data) {
        return data.keys().hasAll([
            'projectId',
            'senderId',
            'ownerId',
            'initials',
            'title',
            'subtitle',
            'status',
            'type',
            'message',
            'displayName',
            'targetName',
            'matchPercent',
            'matchSummary',
            'repositoryCount',
            'commitCount',
            'languageCount',
            'skills',
            'createdAt',
            'respondedAt'
          ])
          && data.keys().hasOnly([
            'projectId',
            'senderId',
            'ownerId',
            'initials',
            'title',
            'subtitle',
            'status',
            'type',
            'message',
            'displayName',
            'targetName',
            'matchPercent',
            'matchSummary',
            'repositoryCount',
            'commitCount',
            'languageCount',
            'skills',
            'createdAt',
            'respondedAt'
          ])
          && data.projectId is string
          && data.projectId.size() > 0
          && data.senderId is string
          && data.ownerId is string
          && data.ownerId.size() > 0
          && data.initials is string
          && data.title is string
          && data.subtitle is string
          && (data.message == null || data.message is string)
          && (data.message == null || data.message.size() <= 280)
          && data.displayName is string
          && data.targetName is string
          && data.matchPercent is int
          && data.matchPercent >= 0
          && data.matchPercent <= 100
          && data.matchSummary is string
          && data.repositoryCount is int
          && data.repositoryCount >= 0
          && data.commitCount is int
          && data.commitCount >= 0
          && data.languageCount is int
          && data.languageCount >= 0
          && data.skills is list
          && data.status == 'pending'
          && data.type == 'sent'
          && data.createdAt == request.time
          && data.respondedAt == null;
      }

      allow read: if request.auth != null
        && (
          // The create transaction probes the deterministic request id before
          // writing it. Reading a missing document returns no data, so allow
          // that probe without exposing other users' requests.
          !exists(/databases/$(database)/documents/requests/$(requestId))
          || resource.data.senderId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
        );

      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.ownerId != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.projectId
        && projectOwnedBy(
          request.resource.data.projectId,
          request.resource.data.ownerId
        )
        && validRequestData(request.resource.data);

      allow update: if request.auth != null
        && (
          (
            resource.data.ownerId == request.auth.uid
            && projectOwnedBy(resource.data.projectId, request.auth.uid)
            && resource.data.status in ['pending', 'isNew']
            && request.resource.data.status in ['accepted', 'declined']
            && request.resource.data.respondedAt == request.time
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['status', 'respondedAt'])
          )
          || (
            resource.data.senderId == request.auth.uid
            && resource.data.status == 'declined'
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.projectId == resource.data.projectId
            && requestId == request.auth.uid + '_' + request.resource.data.projectId
            && projectOwnedBy(
              request.resource.data.projectId,
              request.resource.data.ownerId
            )
            && validRequestData(request.resource.data)
          )
        );

      allow delete: if false;
    }
  }
}
