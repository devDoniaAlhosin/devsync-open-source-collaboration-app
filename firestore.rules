rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles – only the owner can read or write their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Projects – readable by any authenticated user, writable by maintainer.
    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == resource.data.ownerId;
    }

    // Match result cache – each user owns their own cache document.
    match /matches_cache/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Liked matches – each user owns their own saved matches sub-collection.
    match /liked_matches/{userId}/matches/{projectId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Feedback (like / skip actions) – each user writes their own records.
    // Document ID convention: {userId}_{projectId}
    match /feedback/{feedbackId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.action in ['like', 'skip']
                    && request.resource.data.projectId is string
                    && request.resource.data.timestamp is timestamp;
      // No update or delete – feedback is append-only.
    }
  }
}
