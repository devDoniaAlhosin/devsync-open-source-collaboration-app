rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles – only the owner can read or write their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /fcmTokens/{tokenId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    match /feedback/{feedbackId} {
      function validFeedback(data) {
        return data.keys().hasAll([
            'userId',
            'projectId',
            'action',
            'updatedAt'
          ])
          && data.keys().hasOnly([
            'userId',
            'projectId',
            'action',
            'updatedAt'
          ])
          && data.userId == request.auth.uid
          && data.projectId is string
          && data.projectId.size() > 0
          && data.action in ['like', 'skip']
          && data.updatedAt == request.time;
      }

      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
        && feedbackId == request.auth.uid + '_' + request.resource.data.projectId
        && validFeedback(request.resource.data);

      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.projectId == resource.data.projectId
        && feedbackId == request.auth.uid + '_' + request.resource.data.projectId
        && validFeedback(request.resource.data);

      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid
        && feedbackId == request.auth.uid + '_' + resource.data.projectId;
    }

    // Owner CRUD; signed-in read. Non-owners may only +1 counters via transactions.
    match /projects/{projectId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return isSignedIn() && (
          resource.data.ownerId == request.auth.uid
          || resource.data.get('ownerUid', '') == request.auth.uid
        );
      }

      function requestCreatedByViewer() {
        let requestPath = /databases/$(database)/documents/requests/$(request.auth.uid + '_' + projectId);
        return existsAfter(requestPath)
          && getAfter(requestPath).data.projectId == projectId
          && getAfter(requestPath).data.senderId == request.auth.uid
          && getAfter(requestPath).data.ownerId == resource.data.ownerId;
      }

      function onlyIncrementsRequestsCount() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requestsCount'])
          && request.resource.data.requestsCount is int
          && request.resource.data.requestsCount == resource.data.get('requestsCount', 0) + 1;
      }

      function onlyIncrementsViewsCount() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount'])
          && request.resource.data.viewsCount is int
          && request.resource.data.viewsCount == resource.data.get('viewsCount', 0) + 1;
      }

      function pad2(n) {
        return n < 10 ? '0' + string(n) : string(n);
      }

      function todayKeyUtc() {
        return string(request.time.year())
          + '-' + pad2(request.time.month())
          + '-' + pad2(request.time.day());
      }

      function viewCreatedByViewer() {
        let viewPath = /databases/$(database)/documents/views/$(projectId + '_' + request.auth.uid + '_' + todayKeyUtc());
        return existsAfter(viewPath)
          && getAfter(viewPath).data.projectId == projectId
          && getAfter(viewPath).data.viewerId == request.auth.uid;
      }

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.ownerId is string
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId.size() > 0
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() > 0;

      allow update: if (
        isOwner()
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.ownerName is string
          && request.resource.data.ownerName.size() > 0
      ) || (
        isSignedIn()
          && onlyIncrementsRequestsCount()
          && requestCreatedByViewer()
      ) || (
        isSignedIn()
          && onlyIncrementsViewsCount()
          && viewCreatedByViewer()
      );

      allow delete: if isOwner();
    }

    match /views/{viewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.viewerId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.viewerId == request.auth.uid;
    }

    match /requests/{requestId} {
      function projectOwnedBy(projectId, ownerId) {
        let projectPath = /databases/$(database)/documents/projects/$(projectId);
        return exists(projectPath)
          && (
            get(projectPath).data.get('ownerId', '') == ownerId
            || get(projectPath).data.get('ownerUid', '') == ownerId
          );
      }

      function validRequestData(data) {
        return data.keys().hasAll([
            'projectId',
            'senderId',
            'ownerId',
            'initials',
            'title',
            'subtitle',
            'status',
            'type',
            'message',
            'displayName',
            'targetName',
            'matchPercent',
            'matchSummary',
            'repositoryCount',
            'commitCount',
            'languageCount',
            'skills',
            'createdAt',
            'respondedAt'
          ])
          && data.keys().hasOnly([
            'projectId',
            'senderId',
            'ownerId',
            'initials',
            'title',
            'subtitle',
            'status',
            'type',
            'message',
            'displayName',
            'targetName',
            'matchPercent',
            'matchSummary',
            'repositoryCount',
            'commitCount',
            'languageCount',
            'skills',
            'createdAt',
            'respondedAt'
          ])
          && data.projectId is string
          && data.projectId.size() > 0
          && data.senderId is string
          && data.ownerId is string
          && data.ownerId.size() > 0
          && data.initials is string
          && data.title is string
          && data.subtitle is string
          && (data.message == null || data.message is string)
          && (data.message == null || data.message.size() <= 280)
          && data.displayName is string
          && data.targetName is string
          && data.matchPercent is int
          && data.matchPercent >= 0
          && data.matchPercent <= 100
          && data.matchSummary is string
          && data.repositoryCount is int
          && data.repositoryCount >= 0
          && data.commitCount is int
          && data.commitCount >= 0
          && data.languageCount is int
          && data.languageCount >= 0
          && data.skills is list
          && data.status == 'pending'
          && data.type == 'sent'
          && data.createdAt == request.time
          && data.respondedAt == null;
      }

      allow read: if request.auth != null
        && (
          // The create transaction probes the deterministic request id before
          // writing it. Reading a missing document returns no data, so allow
          // that probe without exposing other users' requests.
          !exists(/databases/$(database)/documents/requests/$(requestId))
          || resource.data.senderId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
        );

      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.ownerId != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.projectId
        && projectOwnedBy(
          request.resource.data.projectId,
          request.resource.data.ownerId
        )
        && validRequestData(request.resource.data);

      allow update: if request.auth != null
        && (
          (
            resource.data.ownerId == request.auth.uid
            && projectOwnedBy(resource.data.projectId, request.auth.uid)
            && resource.data.status in ['pending', 'isNew']
            && request.resource.data.status in ['accepted', 'declined']
            && request.resource.data.respondedAt == request.time
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['status', 'respondedAt'])
          )
          || (
            resource.data.senderId == request.auth.uid
            && resource.data.status == 'declined'
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.projectId == resource.data.projectId
            && requestId == request.auth.uid + '_' + request.resource.data.projectId
            && projectOwnedBy(
              request.resource.data.projectId,
              request.resource.data.ownerId
            )
            && validRequestData(request.resource.data)
          )
        );

      // Sender or owner may delete (needed for account wipe).
      allow delete: if request.auth != null
        && (
          resource.data.senderId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
        );
    }

    // Match result cache – each user owns their own cache document.
    match /matches_cache/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Liked matches – each user owns their own saved matches sub-collection.
    match /liked_matches/{userId}/matches/{projectId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Match table (liked matches per ERD)
    match /match/{matchId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Legacy matches collection for backward compatibility
    match /matches/{matchId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Feedback (like / skip actions) – each user writes their own records.
    match /feedback/{feedbackId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.action in ['like', 'skip']
                    && request.resource.data.projectId is string
                    && request.resource.data.timestamp is timestamp;
      allow update, delete: if false;
    }
  }
}
